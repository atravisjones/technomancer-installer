# Environment files
.env
*.env

# Credentials (if using integrations)
credentials_*.json
client_secret_*.json
token_*.json

# Python
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
*.egg-info/

# Node (if using JS integrations)
node_modules/

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo

# Database (if using local DB)
*.db
*.sqlite

# Keep these tracked
!.gitkeep

# The boys — worker failure telemetry
tools/boys-failures.log

# Install files built by install/build-installer.py (they hold a token)
dist/

# The mod API types the Claude app writes
mods/**/.claude-plugin/types/
